APP_ENV=development
DATABASE_URL=sqlite:///./newsroom.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=false
TIMEZONE=Asia/Ho_Chi_Minh

# Select a JSON-schema capable model available to your account.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Set a supported Graph API version from your Meta app configuration.
FACEBOOK_GRAPH_API_VERSION=
FACEBOOK_DRY_RUN=true

# Only approved and explicitly scheduled drafts are dispatched.
AUTO_PUBLISH=false
SCHEDULER_ENABLED=true
# 0 disables automatic news scans.
SCAN_INTERVAL_MINUTES=0
# Optional: path to a TrueType font with Vietnamese glyphs.
CARD_FONT_PATH=
