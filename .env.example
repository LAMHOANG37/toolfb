# Application
APP_ENV=development
DATABASE_URL=sqlite:///./newsroom.db

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Facebook Configuration
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-access-token
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_DRY_RUN=true

# Editor Settings
AUTO_PUBLISH=false
